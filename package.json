{
  "name": "take-one-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "dev:phone": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch server/index.ts --phone\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run --exclude \"tests/browser/**\"",
    "test:browser": "playwright test",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "postinstall": "patch-package --error-on-fail"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^0.468.0",
    "patch-package": "8.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "0.183.2",
    "ws": "^8.21.3",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/supertest": "^7.2.1",
    "@types/three": "^0.183.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^10.0.5",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~5.8.3",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
